---
import Base from '../layouts/Base.astro';
import foi from '../data/foi.json';
import { statSync, existsSync } from 'node:fs';

// Published documents live in public/foi/. Size is read at build time so the
// page cannot advertise a file that is not there: a broken link on the one
// page whose whole point is "here is the paper" would be the worst place on
// the site for it.
const docInfo = (file: string) => {
  const p = new URL(`../../public${file}`, import.meta.url).pathname;
  if (!existsSync(p)) return null;
  const kb = statSync(p).size / 1024;
  return { size: kb >= 1024 ? `${(kb / 1024).toFixed(1)} MB` : `${Math.max(1, Math.round(kb))} KB` };
};

const DOC_KIND: Record<string, string> = {
  form: 'Request form',
  acknowledgment: 'Acknowledgment',
  response: 'Response',
  records: 'Records released',
  fee: 'Fee notice',
  correspondence: 'Correspondence',
};

const STATUS_LABELS: Record<string, string> = {
  drafted: 'Drafted',
  sent: 'Sent — awaiting response',
  acknowledged: 'Acknowledged',
  extended: 'Deadline extended',
  refused: 'Refused — appealing',
  appealed: 'Under appeal at IPC',
  answered: 'Answered',
};
const STATUS_CLASS: Record<string, string> = {
  drafted: 's-drafted', sent: 's-sent', acknowledged: 's-sent', extended: 's-warn',
  refused: 's-bad', appealed: 's-warn', answered: 's-good',
};
const fmt = (d: string | null) => d ? new Date(d + 'T12:00:00').toLocaleDateString('en-CA', { year: 'numeric', month: 'short', day: 'numeric' }) : null;
---
<Base
  title="Paper trail"
  titleFull="ALPR Freedom of Information Requests — Ontario Police"
  description="Our freedom-of-information requests to Ontario police services, published in full with the letters, file numbers and deadlines tracked in public.">
  <h1>The paper trail: our freedom-of-information requests</h1>
  <p class="lede">
    Crowdsourced maps show where cameras are. Only the institutions themselves can show the
    settings — retention periods, sharing agreements, audit reports, and the analysis behind
    their claims. So we ask, formally, under MFIPPA (Ontario's municipal freedom-of-information
    law: $5, any person may file). Every request we send is published here in full — what we
    asked, when, and what came back. Note: Bill 97 (2026) quietly stretched the response
    deadline from 30 calendar days to 45 business days — roughly nine weeks.
  </p>
  <div class="note">
    <strong>Where to send one: <a href="/foi/file">every filing route we have verified</a></strong>
    — 23 police services, ministries and operators, with the fee, the exact cheque payee, the
    form, and the places where their own page does not say. Four of them take payment to
    somebody other than themselves, which is how a request gets returned unfiled.
  </div>
  <div class="note">
    <strong>Take these for your region.</strong> These letters are free to copy and adapt for
    any police service — that's why they're public. Change the institution and the local
    details, include the $5 fee, and send it. If you file one, tell us and we'll track it here.
  </div>

  <div class="tracker">
    {foi.requests.map((r) => (
      <article class="req">
        <header>
          <div>
            <h3>{r.institution}</h3>
            <div class="region">{r.region}</div>
          </div>
          <div class="status-wrap">
            <span class={`status ${STATUS_CLASS[r.status]}`}>{STATUS_LABELS[r.status]}</span>
            {r.fileNumber && <div class="dates">File #{r.fileNumber}</div>}
            {r.dateSent && <div class="dates">Sent {fmt(r.dateSent)}{r.dateDue ? ` · due ${fmt(r.dateDue)}` : ''}</div>}
          </div>
        </header>
        {r.events && r.events.length > 0 && (
          <ol class="timeline-foi">
            {[...r.events].reverse().map((e) => (
              <li>
                <span class="tl-date">{fmt(e.date)}</span>
                <span class="tl-label">{e.label}</span>
                {e.note && <span class="tl-note">{e.note}</span>}
              </li>
            ))}
          </ol>
        )}
        {r.outcome && <p class="outcome">{r.outcome}</p>}
        <div class="filing">
          <span class="filing-how">{r.submission.how}</span>
          {r.submission.portal && <a href={r.submission.portal} rel="noopener">File online →</a>}
        </div>
        {r.documents && r.documents.length > 0 && (
          <div class="docs">
            <div class="docs-head">Documents</div>
            <ul>
              {r.documents.map((d: any) => {
                const info = docInfo(d.file);
                return (
                  <li>
                    <a href={d.file} rel="noopener">
                      <span class="doc-kind">{DOC_KIND[d.kind] ?? 'Document'}</span>{d.label}
                    </a>
                    <span class="doc-meta">
                      PDF{info ? ` · ${info.size}` : ''}{d.date ? ` · ${fmt(d.date)}` : ''}
                      {d.redacted !== false ? ' · redacted' : ''}
                    </span>
                    {d.note && <span class="doc-note">{d.note}</span>}
                  </li>
                );
              })}
            </ul>
          </div>
        )}
        <details>
          <summary>Read the full request ({r.items.length} items)</summary>
          <div class="letter">
            <p class="pre">{r.preamble ?? foi.preamble}</p>
            <p><strong>I request the following records:</strong></p>
            <ol>
              {r.items.map((item) => <li>{item}</li>)}
            </ol>
            <p class="pre">{foi.closing}</p>
          </div>
        </details>
      </article>
    ))}
  </div>

  <h3 class="why-five">Why these five?</h3>
  <p class="lede">
    Toronto runs the largest fleet program in the country and is expanding into AI. Peel and
    Toronto are the retention contrast (24 hours vs 7 days, same technology). York made a
    specific crime-reduction claim — we've asked for the analysis behind it. Waterloo just went
    live on provincial money. And Halton has said nothing at all — which is exactly why it gets
    a request.
  </p>

  <style>
    .tracker { display: flex; flex-direction: column; gap: 0.8rem; margin-top: 1.2rem; }
    .req { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 1rem 1.2rem; }
    .req header { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; }
    .req h3 { font-size: 1.05rem; }
    .region { color: var(--muted); font-size: 0.8rem; }
    .status { display: inline-block; padding: 0.15rem 0.6rem; border-radius: 999px; font-size: 0.76rem; font-weight: 600; }
    .status-wrap { text-align: right; }
    .dates { color: var(--muted); font-size: 0.74rem; margin-top: 0.25rem; }
    .s-drafted { background: rgba(154,167,180,0.15); color: var(--muted); }
    .s-sent { background: rgba(77,163,255,0.15); color: var(--toll); }
    .s-warn { background: rgba(255,181,77,0.15); color: var(--fleet); }
    .s-bad { background: rgba(255,90,95,0.15); color: var(--police); }
    .s-good { background: rgba(88,214,163,0.18); color: #58d6a3; }
    .outcome { margin-top: 0.6rem; font-size: 0.88rem; }
    .timeline-foi { list-style: none; padding: 0; margin: 0.7rem 0 0; border-left: 2px solid var(--line); }
    .timeline-foi li { padding: 0.15rem 0 0.15rem 0.9rem; position: relative; font-size: 0.8rem; }
    .timeline-foi li::before { content: ''; position: absolute; left: -5px; top: 0.55rem; width: 8px; height: 8px; border-radius: 50%; background: var(--toll); }
    .tl-date { color: var(--muted); margin-right: 0.5rem; font-variant-numeric: tabular-nums; }
    .tl-label { font-weight: 600; }
    .tl-note { display: block; color: var(--muted); }
    .filing { display: flex; flex-direction: column; gap: 0.15rem; margin-top: 0.6rem; font-size: 0.8rem; }
    .filing-how { color: var(--text); }
    .filing a { color: var(--toll); }
    .filing-addr { color: var(--muted); }
    .docs { margin-top: 0.7rem; padding-top: 0.6rem; border-top: 1px dashed var(--line); }
    .docs-head {
      font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.05em; color: var(--muted); margin-bottom: 0.35rem;
    }
    .docs ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.45rem; }
    .docs a { color: var(--toll); text-decoration: none; font-size: 0.86rem; }
    .docs a:hover { text-decoration: underline; }
    .doc-kind {
      display: inline-block; margin-right: 0.4rem; padding: 0.02rem 0.4rem;
      border-radius: 999px; font-size: 0.68rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.04em; color: var(--border-cat); background: rgba(176,122,255,0.14);
    }
    .doc-meta { display: block; font-size: 0.72rem; color: var(--muted); margin-top: 0.1rem; }
    .doc-note { display: block; font-size: 0.78rem; color: var(--muted); margin-top: 0.1rem; }
    details { margin-top: 0.7rem; }
    summary { cursor: pointer; color: var(--toll); font-size: 0.86rem; }
    .letter { margin-top: 0.8rem; border-left: 3px solid var(--line); padding-left: 1rem; font-size: 0.86rem; }
    .letter .pre { white-space: pre-line; color: var(--muted); margin-bottom: 0.7rem; }
    .letter ol { padding-left: 1.2rem; }
    .letter li { margin-bottom: 0.55rem; }
    .why-five { margin-top: 1.5rem; }
    @media (max-width: 720px) {
      .req { padding: 0.85rem 0.9rem; }
      .req header { flex-direction: column; gap: 0.4rem; }
      .status-wrap { text-align: left; }
      .letter { padding-left: 0.7rem; }
    }
  </style>
</Base>
