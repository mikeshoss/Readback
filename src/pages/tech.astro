---
import Base from '../layouts/Base.astro';

const systems = [
  {
    name: 'FlockOS + TALON', vendor: 'Flock Safety',
    what: 'The network is the product: ~5,000 agencies can search each other\'s cameras through one lookup (TALON).',
    features: [
      { f: 'Convoy Analysis', d: 'Enter a plate; the system finds vehicles that frequently travel with it — flagged as potential associates even if they only share a commute.' },
      { f: 'Multi-Geo Search', d: 'Follows vehicles between cities and states; case documents describe building "patterns of life."' },
      { f: 'Nova', d: 'A person-lookup layer that "jumps from LPR to person" using data-broker records — reported to have drawn on breached datasets.' },
      { f: 'Drone dispatch', d: 'Aerodome drones launch automatically to camera hits.' },
      { f: 'Audit logs', d: 'Every search logs a typed reason — the mechanism that exposed the Texas abortion search and a police chief\'s stalking. Also the mechanism where "hehehe" passed as a search reason.' },
    ],
    onRecord: 'Grand Prairie, TX police ran a slur through Convoy Analysis six times — targeting a traveling community with no crime specified (EFF, from audit logs).',
  },
  {
    name: 'LEARN / PlateSearch', vendor: 'Motorola (Vigilant + DRN)',
    what: 'The oldest inference engine in the industry, pooling 1.5B+ police reads with 5B+ commercial scans from repossession fleets.',
    features: [
      { f: 'Stakeout', d: 'Lists every plate seen at a chosen location and time — the ACLU\'s reading of NYPD records: who was at a political rally, an abortion clinic, or a gay bar.' },
      { f: 'Associate Analysis', d: 'Flags "possible associates" of a target vehicle — family, friends, and partners get swept in.' },
      { f: 'Locate Analysis', d: 'Predicts the most likely locations to find a vehicle from its historical reads.' },
      { f: 'Commercial pipeline', d: 'The DRN half of the database is collected by private repo drivers and also sold to insurers and lenders.' },
    ],
    onRecord: 'NYPD retains LEARN data for 5 years; ICE bought query access via a $6.8M Thomson Reuters contract.',
  },
  {
    name: 'Fusus + Evidence.com', vendor: 'Axon',
    what: 'A real-time crime centre fusing any-vendor ALPR, private and community camera registries, CAD, and drones into one operational picture. Toronto and York Region\'s platform family.',
    features: [
      { f: 'Camera registries', d: 'Businesses and residents enrol private cameras; police get live or on-request access without owning the hardware.' },
      { f: 'ALPR Sharing', d: 'Partner agencies search each other\'s plate data. Axon\'s own docs note the sharing audit report contains hardcoded placeholder fields — it records that a config changed, not what changed.' },
      { f: 'Face recognition trajectory', d: 'A 2019 ethics commitment against face matching; a December 2025 world-first facial-recognition bodycam trial with Edmonton Police (50 officers, ~7,000-face watch list).' },
    ],
    onRecord: 'Retention and permissions are customer-set with no vendor limit — Toronto sets 7 days where Axon\'s default is 30.',
  },
  {
    name: 'Security Center / AutoVu', vendor: 'Genetec',
    what: 'The structural contrast: agency-controlled deployments with no vendor-run national search pool. Canada\'s most-deployed ALPR software.',
    features: [
      { f: 'Attribute search', d: 'Vehicle type, colour, direction, speed — works with partial or no plate (Cloudrunner ML Core).' },
      { f: 'Customer-owned data', d: 'Sharing beyond the agency requires the agency to build it; Canadian cloud hosting available.' },
    ],
    onRecord: 'Genetec holds zero radio certifications and runs no cross-agency lookup — the counter-example that shows the dragnet is a business-model choice, not a technical necessity.',
  },
  {
    name: 'SafetySmart', vendor: 'SoundThinking',
    what: 'The fusion play: gunshot detection (ShotSpotter), ALPR (PlateRanger), and a person-records search engine (CrimeTracer) in one platform since April 2025.',
    features: [
      { f: 'Sensor-to-person pipeline', d: 'An acoustic event, a plate read, and a records search live in the same workflow — escalation from sensor trigger to person file is the product design.' },
    ],
    onRecord: 'Chicago ended its ~$49M ShotSpotter contract in 2024; about 70% of residents in covered neighbourhoods were Black or Latino.',
  },
  {
    name: 'EOC + SignalTrace', vendor: 'Leonardo ELSAG',
    what: 'The system that drops the plate entirely. SignalTrace builds "electronic fingerprints" from the wireless devices in and around a vehicle.',
    features: [
      { f: 'Device co-travel', d: 'Leonardo\'s own marketing: "identify groups of consumer electronic devices that routinely travel together" — Convoy Analysis for your Bluetooth.' },
      { f: 'Plate-optional', d: 'Their words: works "with or without license plate readers."' },
      { f: 'Certification-invisible', d: 'A receive-only sensor needs no radio authorization — there is no FCC or ISED paper trail for it, by design of the rules.' },
    ],
    onRecord: 'No confirmed paying customers yet — a product looking for its first buyer.',
  },
];

const vendors = [
  {
    name: 'Flock Safety', where: 'US only — zero Canadian police contracts',
    caps: ['Plate reads', 'Vehicle fingerprint (make, colour, stickers, damage)', 'Gunshot detection (Raven)', '"Human distress" audio', 'Drones dispatched to hits'],
    sharing: 'TALON nationwide lookup — ~5,000 agencies search each other\'s data. HOAs and retailers pipe private cameras to police.',
    retention: '30 days default (paid 5-year option)',
    flags: 'ICE side-door searches; abortion-related search across 83,000 cameras; 50+ security vulnerabilities; congressional inquiry; 50+ cities cancelled since 2025.',
  },
  {
    name: 'Axon', where: 'Toronto (in-car), York Region, Denver',
    caps: ['Plate reads (Fleet 3: 4K, 3 lanes)', 'Vehicle attribute search', 'Fixed Outpost (ISED-certified for Canada, Jan 2026) + streetlight Lightpost'],
    sharing: 'Department-by-department agreements; NCIC hotlists include ICE\'s immigration violator file.',
    retention: 'Customer-set — no vendor limit. Axon default 30 days; Toronto sets 7.',
    flags: 'Outpost carries LTE + dual-band Wi-Fi + Bluetooth (FCC-certified loadout). Retention and permissions are admin settings.',
  },
  {
    name: 'Genetec AutoVu', where: 'Canada\'s most common vendor (Montreal) — Brampton, UBC',
    caps: ['Plate reads (SharpV fixed, SharpZ3 in-car)', 'Vehicle type/colour/speed/direction', 'Partial and no-plate search'],
    sharing: 'Agency-controlled only — no vendor-run national pool. Canadian cloud hosting available.',
    retention: 'Customer-controlled',
    flags: 'Cert-verified radio-free (no Wi-Fi/Bluetooth on any model; in-car SharpZ3 has no radios at all). The structural opposite of Flock.',
  },
  {
    name: 'Motorola (Vigilant + DRN)', where: 'US-wide',
    caps: ['Plate reads', 'Attribute + plain-language AI search', 'L6Q portable: LTE, Wi-Fi, Bluetooth and embedded radar onboard', 'Portfolio includes BriefCam facial recognition (separate product)'],
    sharing: 'LEARN-NVLS: 500+ agencies, 1.5B police reads + 5B+ commercial scans from repo fleets — sold to police and insurers.',
    retention: 'Agency-set; indefinite allowed (NYPD: 5 years)',
    flags: 'ICE query access via $6.8M Thomson Reuters contract. The commercial-collection outlier.',
  },
  {
    name: 'Neology (PIPS)', where: 'BC provincial program (RCMP-run)',
    caps: ['Plate reads', 'AI vehicle classification incl. plateless vehicles'],
    sharing: 'Hotlists from ICBC + CPIC, generated daily.',
    retention: 'BC: non-hit reads deleted at end of officer\'s shift — strictest in Canada',
    flags: 'Shows what the technology looks like under strong rules.',
  },
  {
    name: 'Leonardo ELSAG', where: 'US agencies',
    caps: ['Plate reads (in-car, fixed, covert units disguised as utility boxes and toolboxes — their own catalog)', 'SignalTrace: "electronic fingerprints" from phones, AirPods, smartwatches, car head units'],
    sharing: 'Agency-controlled (EOC back office)',
    retention: 'Agency-set',
    flags: 'SignalTrace pairs device signals with plate records — see the antenna problem below.',
  },
  {
    name: 'Jenoptik', where: 'UK national ANPR; US border counties',
    caps: ['Plate reads (Vector, fixed + trailers)', 'TraffiCatch: captures Bluetooth device addresses from phones, earbuds, and car systems and merges them with the plate read'],
    sharing: 'Feeds the UK\'s state-run National ANPR Service; US border deployments via DHS grants',
    retention: 'Agency/national policy',
    flags: 'TraffiCatch has been deployed since ~2019 in Texas border counties (Webb, Val Verde) on DHS grant money — the first documented plate+device tracking in the field.',
  },
  {
    name: 'Perceptics', where: 'The border — CBP and CBSA crossings',
    caps: ['Border-grade plate reads', 'Driver imaging at primary inspection lanes'],
    sharing: 'Federal border infrastructure',
    retention: 'Government-set',
    flags: '2019: copied CBP plate images + ~184,000 traveler face photos to its own network without authorization; got hacked; data hit the dark web. CBSA investigated.',
  },
  {
    name: 'Dahua', where: '21 mapped Canadian police-layer cameras',
    caps: ['Plate reads (ITC series, wired PoE)', 'Datasheet claims recognition of "features of driver and front-seat passenger"'],
    sharing: 'On-premise IP cameras',
    retention: 'Agency-set',
    flags: 'PRC vendor banned from US federal procurement (NDAA §889); FCC halted new equipment authorizations in 2022; still sold freely in Canada.',
  },
];
---
<Base title="The tech">
  <h1>The technology: what it collects, what it infers</h1>
  <p class="lede">
    A camera produces a plate, a timestamp, and a location. The software turns those reads
    into associations, patterns of life, and predictions. One page, both halves — every
    capability sourced to vendor documentation, certification filings, or public records.
  </p>
  <nav class="pills">
    <a href="#software">The systems</a>
    <a href="#hardware">The cameras</a>
    <a href="#antenna">The antenna problem</a>
    <a href="#analysis">Analysis</a>
  </nav>

  <h2 id="software">The systems — what the software does with the reads</h2>
  {systems.map((s) => (
    <section class="sys">
      <h3>{s.name} <span class="vendor-tag">{s.vendor}</span></h3>
      <p class="what">{s.what}</p>
      <ul>
        {s.features.map((x) => <li><strong>{x.f}.</strong> {x.d}</li>)}
      </ul>
      <p class="record">📎 On the record: {s.onRecord}</p>
    </section>
  ))}

  <h3 class="sub">What these features already do — documented</h3>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Use case</th><th>The shipping feature</th></tr></thead>
      <tbody>
        <tr><td>Map who travels with whom</td><td>Flock Convoy Analysis; Vigilant Associate Analysis</td></tr>
        <tr><td>List everyone at a sensitive location</td><td>Vigilant Stakeout</td></tr>
        <tr><td>Predict where a vehicle will be</td><td>Vigilant Locate Analysis</td></tr>
        <tr><td>Track a driver across states</td><td>Flock Multi-Geo (the Texas abortion search touched 83,000 cameras)</td></tr>
        <tr><td>Turn a plate into a person</td><td>Flock Nova</td></tr>
        <tr><td>Screen for immigration status via local alerts</td><td>NCIC hotlist ingestion (ICE's Immigration Violator File)</td></tr>
        <tr><td>Stalk an ex</td><td>Any of them — ~50 documented US cases; the audit log is the only thing that caught anyone</td></tr>
      </tbody>
    </table>
  </div>

  <h2 id="hardware">The cameras — what the hardware can do</h2>
  <div class="note">
    <strong>The structural issue no vendor advertises:</strong> any platform syncing FBI NCIC
    hotlists (Flock, Axon, Vigilant, ELSAG) automatically ingests ICE's Immigration Violator
    File — populated solely by ICE, including administrative warrants no judge ever signed.
    A local plate alert can be an immigration screen whether the local police chose that or not.
  </div>
  {vendors.map((v) => (
    <section class="vendor">
      <h3>{v.name}</h3>
      <p class="where">{v.where}</p>
      <div class="vgrid">
        <div>
          <h4>Capabilities</h4>
          <ul>{v.caps.map((c) => <li>{c}</li>)}</ul>
        </div>
        <div>
          <h4>Data sharing</h4>
          <p>{v.sharing}</p>
          <h4>Retention</h4>
          <p>{v.retention}</p>
        </div>
      </div>
      <p class="flags">⚠ {v.flags}</p>
    </section>
  ))}

  <section class="antenna" id="antenna">
    <h2>⚠ The antenna problem: it stopped being "just plates"</h2>
    <p>
      Two ALPR vendors now sell plate readers that also capture the wireless signals inside
      your car. <strong>Jenoptik's TraffiCatch</strong> — deployed in Texas border counties since
      ~2019 on DHS grant money — detects Bluetooth addresses from phones, earbuds, and car
      systems and merges them with the plate read. <strong>Leonardo's SignalTrace</strong>
      (announced 2026) markets "electronic fingerprints": identifying "groups of consumer
      electronic devices that routinely travel together," with or without a readable plate.
      Your phone randomizes its identifiers; your earbuds, smartwatch, car head unit, and
      tire-pressure sensors mostly don't — and the <em>combination</em> of devices you carry
      is a signature even when each one behaves.
    </p>
    <p>
      The sharper fact: on most modern networked ALPR hardware, <strong>the radio is already
      installed</strong>. Flock's Falcon contains an active Wi-Fi + Bluetooth module (18,000+
      of its own hotspots are visible on public wardriving databases); Motorola's L6Q and
      Axon's Outpost ship certified radio stacks. None of them sniff today — but for those
      platforms, device tracking is a software update plus a legal decision, not a hardware
      purchase. Genetec's cameras are the cert-verified exception: no Wi-Fi or Bluetooth on
      any model.
    </p>
    <p>
      And no retention statute in the <a href="/rules">rules comparison</a> mentions device
      signals. Every rule ever written about this technology regulates the plate.
    </p>
  </section>

  <section class="analysis" id="analysis">
    <h2>Analysis: where the documented capabilities point</h2>
    <p class="disclaimer">
      This section is analysis, not reporting — written from professional experience
      building AI systems. Every item extends a capability the vendor documents; none
      asserts a system is doing this today.
    </p>
    <ul>
      <li><strong>The borrowed car doesn't help you.</strong> SignalTrace fingerprints the devices, not the vehicle, and works "with or without" a plate read — the vendor's framing, taken one honest step: switch cars, keep your phone and watch, and you're the same fingerprint on a different chassis.</li>
      <li><strong>Four devices that always move together are an inference engine's favourite fact.</strong> "Devices that routinely travel together" (Leonardo's words) is a household, a crew, a carpool, a congregation — association mapping that never needed a licence plate. The plate-side version already ships as Convoy Analysis.</li>
      <li><strong>Escalation is the roadmap, not a slippery slope.</strong> Flock already launches drones off camera hits; SoundThinking already chains gunshot → plate → person-records in one workflow. Sensor event to person file is the documented product direction of the two most aggressive vendors.</li>
      <li><strong>The least-regulated layer is growing fastest.</strong> Passive receivers carry no certification trail, and no retention rule in our <a href="/rules">rules comparison</a> mentions device signals. The inference layer's newest input sits in the emptiest part of the rulebook.</li>
    </ul>
  </section>

  <style>
    .sys, .vendor { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 1.1rem 1.25rem; margin-top: 1rem; }
    .sys h3, .vendor h3 { margin: 0 0 0.2rem; font-size: 1.05rem; }
    .vendor-tag { color: var(--toll); font-size: 0.8rem; font-weight: 600; margin-left: 0.4rem; }
    .what { color: var(--muted); font-size: 0.9rem; margin-bottom: 0.6rem; }
    .sys ul { margin: 0; padding-left: 1.15rem; font-size: 0.88rem; }
    .sys li { margin-bottom: 0.4rem; }
    .record { margin-top: 0.7rem; font-size: 0.84rem; color: var(--fleet); }
    .sub { margin-top: 1.5rem; }
    .where { color: var(--toll); font-size: 0.82rem; font-weight: 600; margin-bottom: 0.6rem; }
    .vgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .vgrid h4 { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); margin-bottom: 0.25rem; }
    .vgrid ul { margin: 0; padding-left: 1.1rem; font-size: 0.86rem; }
    .vgrid p { font-size: 0.86rem; color: var(--text); margin-bottom: 0.6rem; }
    .flags { margin-top: 0.7rem; font-size: 0.84rem; color: var(--fleet); }
    .antenna { background: var(--panel); border: 1px solid var(--police); border-radius: 10px; padding: 1.1rem 1.25rem; margin-top: 1.5rem; }
    .antenna h2 { margin: 0 0 0.5rem; color: var(--police); }
    .antenna p { font-size: 0.9rem; color: var(--text); margin-bottom: 0.6rem; }
    .antenna a { color: var(--toll); }
    .analysis { border: 1px solid var(--toll); border-radius: 10px; padding: 1.1rem 1.25rem; margin-top: 1.5rem; background: var(--panel); }
    .analysis h2 { margin-top: 0; color: var(--toll); }
    .disclaimer { color: var(--muted); font-size: 0.84rem; margin-bottom: 0.8rem; font-style: italic; }
    .analysis ul { padding-left: 1.15rem; font-size: 0.9rem; }
    .analysis li { margin-bottom: 0.6rem; }
    .analysis a { color: var(--toll); }
    @media (max-width: 640px) { .vgrid { grid-template-columns: 1fr; } }
  </style>
</Base>
