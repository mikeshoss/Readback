---
import Base from '../layouts/Base.astro';

const systems = [
  {
    name: 'FlockOS + TALON', vendor: 'Flock Safety',
    what: 'The network is the product: ~5,000 agencies can search each other\'s cameras through one lookup (TALON).',
    features: [
      { f: 'Convoy Analysis', d: 'Enter a plate; the system finds vehicles that frequently travel with it — flagged as potential associates even if they only share a commute.' },
      { f: 'Multi-Geo Search', d: 'Follows vehicles between cities and states; case documents describe building "patterns of life."' },
      { f: 'Nova', d: 'A person-lookup layer that "jumps from LPR to person" using data-broker records — reported to have drawn on breached datasets.' },
      { f: 'Drone dispatch', d: 'Aerodome drones launch automatically to camera hits.' },
      { f: 'Audit logs', d: 'Every search logs a typed reason — the mechanism that exposed the Texas abortion search and a police chief\'s stalking. Also the mechanism where "hehehe" passed as a search reason.' },
    ],
    onRecord: 'Grand Prairie, TX police ran a slur through Convoy Analysis six times — targeting a traveling community with no crime specified (EFF, from audit logs).',
  },
  {
    name: 'LEARN / PlateSearch', vendor: 'Motorola (Vigilant + DRN)',
    what: 'The oldest inference engine in the industry, pooling 1.5B+ police reads with 5B+ commercial scans from repossession fleets.',
    features: [
      { f: 'Stakeout', d: 'Lists every plate seen at a chosen location and time — the ACLU\'s reading of NYPD records: who was at a political rally, an abortion clinic, or a gay bar.' },
      { f: 'Associate Analysis', d: 'Flags "possible associates" of a target vehicle — family, friends, and partners get swept in.' },
      { f: 'Locate Analysis', d: 'Predicts the most likely locations to find a vehicle from its historical reads.' },
      { f: 'Commercial pipeline', d: 'The DRN half of the database is collected by private repo drivers and also sold to insurers and lenders.' },
    ],
    onRecord: 'NYPD retains LEARN data for 5 years; ICE bought query access via a $6.8M Thomson Reuters contract.',
  },
  {
    name: 'Fusus + Evidence.com', vendor: 'Axon',
    what: 'A real-time crime centre that fuses any-vendor ALPR, private and community camera registries, CAD, and drones into one operational picture. Toronto and York Region\'s platform family.',
    features: [
      { f: 'Camera registries', d: 'Businesses and residents enrol private cameras; police get live or on-request access without owning the hardware.' },
      { f: 'ALPR Sharing', d: 'Partner agencies search each other\'s plate data. Axon\'s own docs note the sharing audit report contains hardcoded placeholder fields — it records that a config changed, not what changed.' },
      { f: 'Face recognition trajectory', d: 'A 2019 ethics commitment against face matching; a December 2025 world-first facial-recognition bodycam trial with Edmonton Police (50 officers, ~7,000-face watch list).' },
    ],
    onRecord: 'Retention and permissions are customer-set with no vendor limit — Toronto sets 7 days where Axon\'s default is 30.',
  },
  {
    name: 'Security Center / AutoVu', vendor: 'Genetec',
    what: 'The structural contrast: agency-controlled deployments with no vendor-run national search pool. Canada\'s most-deployed ALPR software.',
    features: [
      { f: 'Attribute search', d: 'Vehicle type, colour, direction, speed — works with partial or no plate (Cloudrunner ML Core).' },
      { f: 'Customer-owned data', d: 'Sharing beyond the agency requires the agency to build it; Canadian cloud hosting available.' },
    ],
    onRecord: 'Genetec holds zero radio certifications and runs no cross-agency lookup — the counter-example that shows the dragnet is a business-model choice, not a technical necessity.',
  },
  {
    name: 'SafetySmart', vendor: 'SoundThinking',
    what: 'The fusion play: gunshot detection (ShotSpotter), ALPR (PlateRanger), and a person-records search engine (CrimeTracer) integrated in one platform since April 2025.',
    features: [
      { f: 'Sensor-to-person pipeline', d: 'An acoustic event, a plate read, and a records search live in the same workflow — escalation from sensor trigger to person file is the product design.' },
    ],
    onRecord: 'Chicago ended its ~$49M ShotSpotter contract in 2024; about 70% of residents in covered neighbourhoods were Black or Latino.',
  },
  {
    name: 'EOC + SignalTrace', vendor: 'Leonardo ELSAG',
    what: 'The system that drops the plate entirely. SignalTrace builds "electronic fingerprints" from the wireless devices in and around a vehicle.',
    features: [
      { f: 'Device co-travel', d: 'Leonardo\'s own marketing: "identify groups of consumer electronic devices that routinely travel together" — Convoy Analysis for your Bluetooth.' },
      { f: 'Plate-optional', d: 'Their words: works "with or without license plate readers."' },
      { f: 'Certification-invisible', d: 'A receive-only sensor needs no radio authorization — there is no FCC or ISED paper trail for it, by design of the rules.' },
    ],
    onRecord: 'No confirmed paying customers yet — a product looking for its first buyer.',
  },
];
---
<Base title="Systems">
  <h1>The other half: what the software does with the reads</h1>
  <p class="lede">
    A camera produces a plate, a timestamp, and a location. Everything you should actually
    care about happens afterward, in the software — where reads become associations,
    patterns of life, and predictions. This page covers each platform's documented
    analytical features, with sources (<a href="/cameras">the cameras</a> covers the
    hardware half); the analysis section at the end is clearly marked as analysis, and
    extrapolates only from capabilities the vendors document themselves.
  </p>

  {systems.map((s) => (
    <section class="sys">
      <h2>{s.name} <span class="vendor">{s.vendor}</span></h2>
      <p class="what">{s.what}</p>
      <ul>
        {s.features.map((x) => <li><strong>{x.f}.</strong> {x.d}</li>)}
      </ul>
      <p class="record">📎 On the record: {s.onRecord}</p>
    </section>
  ))}

  <h2>What these features already do — documented</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Use case</th><th>The shipping feature</th></tr></thead>
      <tbody>
        <tr><td>Map who travels with whom</td><td>Flock Convoy Analysis; Vigilant Associate Analysis</td></tr>
        <tr><td>List everyone at a sensitive location</td><td>Vigilant Stakeout</td></tr>
        <tr><td>Predict where a vehicle will be</td><td>Vigilant Locate Analysis</td></tr>
        <tr><td>Track a driver across states</td><td>Flock Multi-Geo (the Texas abortion search touched 83,000 cameras)</td></tr>
        <tr><td>Turn a plate into a person</td><td>Flock Nova</td></tr>
        <tr><td>Screen for immigration status via local alerts</td><td>NCIC hotlist ingestion (ICE's Immigration Violator File)</td></tr>
        <tr><td>Stalk an ex</td><td>Any of them — ~50 documented US cases; the audit log is the only thing that caught anyone</td></tr>
      </tbody>
    </table>
  </div>

  <section class="analysis">
    <h2>Analysis: where the documented capabilities point</h2>
    <p class="disclaimer">
      This section is analysis, not reporting — written from professional experience
      building AI systems. Every item extends a capability the vendor documents; none
      asserts a system is doing this today.
    </p>
    <ul>
      <li><strong>The borrowed car doesn't help you.</strong> SignalTrace fingerprints the devices, not the vehicle, and works "with or without" a plate read — the vendor's framing, taken one honest step: switch cars, keep your phone and watch, and you're the same fingerprint on a different chassis.</li>
      <li><strong>Four devices that always move together are an inference engine's favourite fact.</strong> "Devices that routinely travel together" (Leonardo's words) is a household, a crew, a carpool, a congregation — association mapping that never needed a licence plate. The plate-side version already ships as Convoy Analysis.</li>
      <li><strong>Escalation is the roadmap, not a slippery slope.</strong> Flock already launches drones off camera hits; SoundThinking already chains gunshot → plate → person-records in one workflow. Sensor event to person file is the documented product direction of the two most aggressive vendors.</li>
      <li><strong>The least-regulated layer is growing fastest.</strong> Passive receivers carry no certification trail, and no retention rule anywhere in our <a href="/rules">rules comparison</a> mentions device signals. The inference layer's newest input sits in the emptiest part of the rulebook.</li>
    </ul>
  </section>

  <style>
    .sys { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 1.1rem 1.25rem; margin-top: 1rem; }
    .sys h2 { margin: 0 0 0.2rem; }
    .vendor { color: var(--toll); font-size: 0.8rem; font-weight: 600; margin-left: 0.4rem; }
    .what { color: var(--muted); font-size: 0.9rem; margin-bottom: 0.6rem; }
    .sys ul { margin: 0; padding-left: 1.15rem; font-size: 0.88rem; }
    .sys li { margin-bottom: 0.4rem; }
    .record { margin-top: 0.7rem; font-size: 0.84rem; color: var(--fleet); }
    .analysis { border: 1px solid var(--toll); border-radius: 10px; padding: 1.1rem 1.25rem; margin-top: 1.5rem; background: var(--panel); }
    .analysis h2 { margin-top: 0; color: var(--toll); }
    .disclaimer { color: var(--muted); font-size: 0.84rem; margin-bottom: 0.8rem; font-style: italic; }
    .analysis ul { padding-left: 1.15rem; font-size: 0.9rem; }
    .analysis li { margin-bottom: 0.6rem; }
    .analysis a { color: var(--toll); }
  </style>
</Base>
