---
interface Props {
  title: string;
  // Set when the page needs a complete <title> of its own. `title` still
  // supplies the nav-length name; this replaces the "· Readback" template so
  // the suffix doesn't eat the character budget search engines truncate at.
  titleFull?: string;
  description?: string;
  fullBleed?: boolean;
  breadcrumbs?: { name: string; href: string }[];
}
const {
  title,
  titleFull,
  description = 'Mapping automated licence plate readers in Canada — where they are, what they can do, and what the settings say.',
  fullBleed = false,
  breadcrumbs,
} = Astro.props;
const pageTitle = titleFull ?? `${title} · Readback`;
const nav = [
  { href: '/', label: 'The map' },
  { href: '/tech', label: 'The tech' },
  { href: '/rules', label: 'The rules' },
  { href: '/evidence', label: 'Evidence' },
  { href: '/news', label: 'News' },
  { href: '/foi', label: 'Paper trail' },
];
const path = Astro.url.pathname;
const site = Astro.site ?? new URL('https://readback.ofrecord.ca');
const canonical = new URL(path, site);

const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': `${site.origin}/#organization`,
    name: 'Readback',
    url: site.origin,
    description: 'Independent Canadian project mapping automated licence plate readers and documenting what the operators actually say about them.',
    email: 'themiltonrecord@gmail.com',
    sameAs: ['https://github.com/mikeshoss/Readback'],
  },
  {
    '@type': 'WebSite',
    '@id': `${site.origin}/#website`,
    name: 'Readback',
    url: site.origin,
    description: 'Crowdsourced map and sourced record of ALPR surveillance in Canada.',
    publisher: { '@id': `${site.origin}/#organization` },
    inLanguage: 'en-CA',
  },
];
if (breadcrumbs?.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: new URL(b.href, site).href,
    })),
  });
}
const schema = { '@context': 'https://schema.org', '@graph': graph };
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="tMkis1NXiAWz2osb003FFUiPgbJBRLBuIuk95ZR1M60" />
    <meta name="msvalidate.01" content="819797485C3B438C1C1F85BBD184426E" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="Readback" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:image" content={new URL('/og.png', site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Readback — automated licence plate readers in Canada, mapped." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', site)} />
    <meta name="theme-color" content="#101418" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" sizes="180x180" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <!-- Google tag (gtag.js). is:inline keeps both tags verbatim — Astro would
         otherwise bundle them and gtag must stay a global. -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-Q93NYEFQTS"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-Q93NYEFQTS');
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Read<span>back</span></a>
      <nav>
        {nav.map((n) => (
          <a href={n.href} class={path === n.href || (n.href !== '/' && path.startsWith(n.href)) ? 'active' : ''}>{n.label}</a>
        ))}
      </nav>
    </header>
    <main class={fullBleed ? 'full-bleed' : 'page'}>
      <slot />
    </main>
    {!fullBleed && (
      <footer class="site-footer">
        <p>
          Camera data © OpenStreetMap contributors (ODbL). Every claim on this site is sourced.
          <a href="/alpr">Cameras by region</a> ·
          <a href="/tracking">What we track</a> ·
          <a href="/about">About &amp; contact</a> · <a href="mailto:themiltonrecord@gmail.com">themiltonrecord@gmail.com</a> ·
          <a href="https://github.com/mikeshoss/Readback" rel="noopener">Open research base</a>
        </p>
      </footer>
    )}
    <style is:global>
      :root {
        --bg: #101418;
        --panel: #1a2028;
        --panel-2: #222a35;
        --line: #2e3846;
        --text: #e8edf2;
        --muted: #9aa7b4;
        --police: #ff5a5f;
        --toll: #4da3ff;
        --border-cat: #b07aff;
        --fleet: #ffb54d;
        --accent: #ff5a5f;
      }
      * { box-sizing: border-box; margin: 0; }
      html, body { height: 100%; }
      body {
        background: var(--bg);
        color: var(--text);
        font: 15px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        display: flex; flex-direction: column; min-height: 100vh;
      }
      a { color: inherit; }
      .site-header {
        display: flex; align-items: center; gap: 1.5rem;
        padding: 0.7rem 1.25rem;
        background: var(--panel);
        border-bottom: 1px solid var(--line);
        position: sticky; top: 0; z-index: 20;
      }
      .brand { font-weight: 800; font-size: 1.1rem; letter-spacing: 0.02em; text-decoration: none; }
      .brand span { color: var(--accent); }
      .site-header nav { display: flex; gap: 0.25rem; flex-wrap: wrap; }
      .site-header nav a {
        text-decoration: none; color: var(--muted);
        padding: 0.35rem 0.7rem; border-radius: 6px; font-weight: 500;
      }
      .site-header nav a:hover { color: var(--text); background: var(--panel-2); }
      .site-header nav a.active { color: var(--text); background: var(--panel-2); }
      main.page { max-width: 76rem; width: 100%; margin: 0 auto; padding: 2rem 1.5rem 3rem; flex: 1; }
      main.page > * { overflow-wrap: break-word; }
      main.full-bleed { flex: 1; display: flex; min-height: 0; }
      .site-footer { padding: 1rem 1.25rem; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.8rem; }
      .site-footer a { color: var(--muted); }
      .site-footer a:hover { color: var(--text); }
      h1 { font-size: 1.7rem; line-height: 1.25; margin-bottom: 0.5rem; }
      h2 { font-size: 1.2rem; margin: 2rem 0 0.6rem; }
      p.lede { color: var(--muted); max-width: 46rem; margin-bottom: 1rem; }
      table { border-collapse: collapse; width: 100%; font-size: 0.88rem; }
      .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 8px; }
      th, td { text-align: left; padding: 0.5rem 0.7rem; border-bottom: 1px solid var(--line); vertical-align: top; }
      th { background: var(--panel); position: sticky; top: 0; }
      tr:last-child td { border-bottom: none; }
.flag {
        display: inline-block; font-size: 0.85em; margin-right: 0.3rem;
        vertical-align: 1px; font-family: "Apple Color Emoji","Segoe UI Emoji",sans-serif;
      }
      .origin-note {
        background: var(--panel); border: 1px solid var(--line);
        border-left: 3px solid var(--toll); border-radius: 8px;
        padding: 0.8rem 1rem; margin: 1rem 0; color: var(--muted); font-size: 0.88rem;
      }
      .origin-note strong { color: var(--text); }
      .tag { display: inline-block; padding: 0.05rem 0.45rem; border-radius: 999px; font-size: 0.75rem; font-weight: 600; white-space: nowrap; }
      .tag.hot { background: rgba(255,90,95,0.15); color: var(--police); }
      .tag.cool { background: rgba(77,163,255,0.15); color: var(--toll); }
      .pills { display: flex; gap: 0.4rem; flex-wrap: wrap; margin: 0.8rem 0 1.2rem; }
      .pills a {
        text-decoration: none; color: var(--muted); font-size: 0.82rem; font-weight: 600;
        padding: 0.3rem 0.75rem; border: 1px solid var(--line); border-radius: 999px;
        background: var(--panel);
      }
      .pills a:hover { color: var(--text); border-color: var(--toll); }
      .note {
        background: var(--panel); border: 1px solid var(--line); border-left: 3px solid var(--accent);
        border-radius: 8px; padding: 0.8rem 1rem; margin: 1rem 0; color: var(--muted); font-size: 0.9rem;
      }
      .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: 0.8rem; margin-top: 1rem; }
      .card { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 0.9rem 1rem; }
      .card h3 { font-size: 0.95rem; margin-bottom: 0.25rem; }
      .card .meta { color: var(--fleet); font-size: 0.8rem; font-weight: 600; margin-bottom: 0.4rem; }
      .card p { color: var(--muted); font-size: 0.84rem; }
      @media (max-width: 720px) {
        .site-header { padding: 0.5rem 0.75rem; gap: 0.75rem; }
        .site-header nav {
          overflow-x: auto; flex-wrap: nowrap; -webkit-overflow-scrolling: touch;
          scrollbar-width: none; margin-right: -0.75rem; padding-right: 0.75rem;
        }
        .site-header nav::-webkit-scrollbar { display: none; }
        .site-header nav a { padding: 0.4rem 0.55rem; white-space: nowrap; }
        main.page { padding: 1.25rem 0.9rem 2.5rem; }
        h1 { font-size: 1.35rem; }
        h2 { font-size: 1.05rem; }
        th, td { padding: 0.45rem 0.5rem; font-size: 0.82rem; }
        .cards { grid-template-columns: 1fr; }
        main.full-bleed { display: block; }
      }
    </style>
  </body>
</html>
